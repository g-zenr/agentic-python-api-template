ENV=dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic
JWT_SECRET=change-me-to-a-long-random-string
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","fil"]
CORS_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]
# Auth / tokens
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REQUIRE_EMAIL_VERIFICATION=false
# Request limits
MAX_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Observability
LOG_FORMAT=text                   # text | json (json required in prod)
METRICS_ENABLED=true
METRICS_TOKEN=
WORKER_METRICS_PORT=9100
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentic-api
OTEL_EXPORTER_OTLP_ENDPOINT=
# Database pool
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT_SECONDS=10
DB_TX_TIMEOUT_MS=10000
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
# Email
EMAIL_BACKEND=console             # console | smtp
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
APP_BASE_URL=http://localhost:3000
VERIFICATION_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=30
ACCOUNT_ERASE_DELAY_DAYS=7
AUDIT_PII_RETENTION_DAYS=90
IDEMPOTENCY_TTL_HOURS=24
# MCP (per-client scoped keys; JSON list of {name, key_sha256, tools})
MCP_ENABLED=true
MCP_CLIENTS=[]
# Cache
CACHE_BACKEND=memory          # memory | redis (use redis in prod)
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=agentic
CACHE_MEMORY_MAX_ITEMS=10000
# Background jobs
WORKER_EMBEDDED=true          # dev convenience; set false in prod and run `make worker`
WORKER_CONCURRENCY=4
WORKER_POLL_SECONDS=1.0
JOB_STALE_SECONDS=120
JOB_RETENTION_DAYS=14
JOB_POLL_HINT_SECONDS=2
# Audit & activity
ACTIVITY_ENABLED=true
ACTIVITY_BATCH_SIZE=100
ACTIVITY_FLUSH_SECONDS=2.0
ACTIVITY_QUEUE_MAX=10000
ACTIVITY_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365      # 0 = keep forever
AUDIT_FAIL_CLOSED=false
TRUST_PROXY_HEADERS=false     # true only behind a trusted reverse proxy (reads X-Forwarded-For)