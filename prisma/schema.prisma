generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider    = "postgresql"
  url         = env("DATABASE_URL")
  directUrl   = env("DIRECT_DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum GrantEffect {
  ALLOW
  DENY
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password_hash    String
  name             String
  role             Role      @default(USER)
  locale           String    @default("en")
  is_active        Boolean   @default(true)
  token_version    Int       @default(0)
  email_verified_at DateTime?
  deleted_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  notes            Note[] 
  jobs             Job[] 
  refresh_tokens   RefreshToken[] 
  one_time_tokens  OneTimeToken[] 
  grants           PermissionGrant[] 
 
  @@map("users") 
} 

model PermissionGrant {
  id         String      @id @default(uuid())
  user_id    String
  resource   String
  action     String
  effect     GrantEffect
  conditions Json?
  granted_by String?
  expires_at DateTime?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, resource, action])
  @@index([user_id])
  @@map("permission_grants")
}

model Note {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  body       String   @default("")
  version    Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("notes")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Job {
  id               String    @id @default(uuid())
  type             String
  status           JobStatus @default(QUEUED)
  payload          Json      @default("{}")
  result           Json?
  error            String?
  progress         Int       @default(0)
  attempts         Int       @default(0)
  max_attempts     Int       @default(3)
  priority         Int       @default(0)
  run_at           DateTime  @default(now())
  locked_by        String?
  heartbeat_at     DateTime?
  started_at       DateTime?
  finished_at      DateTime?
  cancel_requested Boolean   @default(false)
  dedupe_key       String?   @unique
  request_id       String?
  user_id          String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  user             User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status, run_at, priority])
  @@index([user_id, created_at])
  @@map("jobs")
}

model AuditLog {
  id            String   @id @default(uuid())
  occurred_at   DateTime @default(now())
  actor_id      String?
  actor_type    String
  action        String
  resource_type String
  resource_id   String?
  outcome       String
  changes       Json?
  metadata      Json?
  request_id    String?
  ip            String?
  user_agent    String?

  @@index([actor_id, occurred_at])
  @@index([resource_type, resource_id, occurred_at])
  @@index([action, occurred_at])
  @@index([occurred_at])
  @@map("audit_logs")
}

model ActivityLog {
  id          String   @id @default(uuid())
  occurred_at DateTime @default(now())
  user_id     String?
  method      String
  path        String
  status_code Int
  duration_ms Int
  request_id  String?
  ip          String?

  @@index([user_id, occurred_at])
  @@index([occurred_at])
  @@map("activity_logs")
}

model RefreshToken {
  id          String    @id @default(uuid())
  user_id     String
  family_id   String
  token_hash  String    @unique
  expires_at  DateTime
  revoked_at  DateTime?
  replaced_by String?
  ip          String?
  user_agent  String?
  created_at  DateTime  @default(now())
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id         String    @id @default(uuid())
  user_id    String
  purpose    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
  @@map("one_time_tokens")
}

model IdempotencyRecord {
  id            String   @id @default(uuid())
  scope         String
  key           String
  request_hash  String
  status_code   Int?
  response      Json?
  created_at    DateTime @default(now())

  @@unique([scope, key])
  @@index([created_at])
  @@map("idempotency_records")
}